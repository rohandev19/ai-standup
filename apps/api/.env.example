# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# ==========================================
# REDIS
# ==========================================
REDIS_HOST="your-redis-host.upstash.io"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
# REDIS_TLS="true"  # Uncomment if your Redis provider requires TLS

# ==========================================
# JWT & SECURITY
# ==========================================
JWT_SECRET="your-super-secure-random-string-min-64-characters-recommended"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV="development"  # Change to "production" for production
PORT="4000"
FRONTEND_URL="http://localhost:3000"  # Change to your production frontend URL

# ==========================================
# AI SERVICE - Experiential Labs (DeepSeek)
# ==========================================
# Get your API key at: https://platform.experientiallabs.ai
# Note: Requires $1 card verification (refunded to balance)
EXPLABS_API_KEY="xpl_your_api_key_here"

# ==========================================
# EMAIL SERVICE
# ==========================================

# --- DEVELOPMENT (Mailpit for local testing) ---
# Mailpit runs on localhost:1025 (SMTP) and localhost:8025 (Web UI)
# Download: https://github.com/axllent/mailpit
SMTP_HOST="localhost"
SMTP_PORT="1025"
# No auth needed for Mailpit

# --- PRODUCTION ---
# Uncomment and configure ONE of the options below:

# Option 1: SendGrid (Recommended)
# Sign up: https://sendgrid.com
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your_sendgrid_api_key"
# SMTP_FROM="noreply@yourdomain.com"

# Option 2: AWS SES
# SMTP_HOST="email-smtp.us-east-1.amazonaws.com"  # Change region as needed
# SMTP_PORT="587"
# SMTP_USER="your_aws_smtp_username"
# SMTP_PASS="your_aws_smtp_password"
# SMTP_FROM="noreply@yourdomain.com"

# Option 3: Mailgun
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="postmaster@yourdomain.mailgun.org"
# SMTP_PASS="your_mailgun_password"
# SMTP_FROM="noreply@yourdomain.com"

# Option 4: Gmail (Not recommended for production)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your_gmail@gmail.com"
# SMTP_PASS="your_gmail_app_password"  # Use App Password, not regular password
# SMTP_FROM="your_gmail@gmail.com"

# Option 5: Other SMTP Provider
# SMTP_HOST="your_smtp_host"
# SMTP_PORT="587"  # or 465 for SSL
# SMTP_USER="your_smtp_username"
# SMTP_PASS="your_smtp_password"
# SMTP_FROM="noreply@yourdomain.com"

# ==========================================
# BILLING (Stripe)
# ==========================================
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."

# ==========================================
# MONITORING & LOGGING (Optional)
# ==========================================
# SENTRY_DSN="https://your-sentry-dsn"
# LOG_LEVEL="info"  # debug, info, warn, error
